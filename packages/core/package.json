{
  "name": "@usesounds/core",
  "version": "0.1.0",
  "description": "Zero-dependency Web Audio engine for synthesized UI sounds (tick, pop, tap, toggle) with declarative data-sound support. Framework-agnostic core of usesounds.",
  "keywords": [
    "sound",
    "ui-sounds",
    "web-audio",
    "audio",
    "synth",
    "feedback",
    "click",
    "usesounds"
  ],
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usesounds.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/usesounds/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/usesounds/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@types/bun": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
