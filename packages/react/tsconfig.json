{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // Browser library: Web Audio, window, document, matchMedia.
    "lib": [
      "esnext",
      "dom"
    ],
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    // Style Options
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Typecheck and tests use @usesounds/core's source, so they don't need a
    // prior build. tsconfig.build.json drops this so the build stays external.
    "paths": {
      "@usesounds/core": [
        "../core/src/index.ts"
      ]
    },
    "skipLibCheck": true,

    // Other Outputs
    "sourceMap": true,

    // Recommended Options
    "strict": true,
    "target": "esnext",
    "types": [
      "bun"
    ],
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src",
    "tests"
  ]
}
