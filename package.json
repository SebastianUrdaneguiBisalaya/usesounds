{
  "name": "usesounds-monorepo",
  "version": "0.0.0",
  "description": "Monorepo workspace root for usesounds: @usesounds/core (framework-agnostic Web Audio engine) + @usesounds/react (React bindings).",
  "license": "ISC",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@happy-dom/global-registrator": "21.0.4",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@types/bun": "1.4.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tsup": "8.5.1",
      "typescript": "6.0.3"
    }
  },
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './packages/*' dev",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun run --filter './packages/*' test",
    "test:watch": "bun test --watch",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "9.1.7"
  }
}
